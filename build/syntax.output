State 15

    4 block_list: block_list block .

    $default  reduce using rule 4 (block_list)


State 16

    5 block: BEGIN . block_list END

    $default  reduce using rule 3 (block_list)

    block_list  go to state 17


State 17

    4 block_list: block_list . block
    5 block: BEGIN block_list . END

    "main start"   shift, and go to state 8
    "main end"     shift, and go to state 18
    "func"         shift, and go to state 9
    "func end"     shift, and go to state 19
    "while start"  shift, and go to state 10
    "while end"    shift, and go to state 20
    "for start"    shift, and go to state 11
    "for end"      shift, and go to state 21
    "if start"     shift, and go to state 12
