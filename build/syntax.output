Nonterminals, with rules where they appear

$accept (43)
    on left: 0
Program (44)
    on left: 1, on right: 0
program_name (45)
    on left: 2, on right: 1
block_list (46)
    on left: 3 4, on right: 1 4 5
block (47)
    on left: 5, on right: 4
BEGIN (48)
    on left: 6 7 8 9 10 11 12, on right: 5
END (49)
    on left: 13 14 15 16 17 18 19, on right: 5


State 0

    0 $accept: . Program "EOF"

    "any other element must be treated as a word"  shift, and go to state 1

    Program       go to state 2
    program_name  go to state 3


State 1

    2 program_name: "any other element must be treated as a word" .

    $default  reduce using rule 2 (program_name)


State 2

    0 $accept: Program . "EOF"

    "EOF"  shift, and go to state 4


State 3

    1 Program: program_name . "space" ";" block_list

    "space"  shift, and go to state 5


State 4

    0 $accept: Program "EOF" .

    $default  accept


State 5

    1 Program: program_name "space" . ";" block_list

    ";"  shift, and go to state 6


State 6

    1 Program: program_name "space" ";" . block_list

    $default  reduce using rule 3 (block_list)

    block_list  go to state 7


State 7

    1 Program: program_name "space" ";" block_list .
    4 block_list: block_list . block

    "main start"   shift, and go to state 8
    "func"         shift, and go to state 9
    "while start"  shift, and go to state 10
    "for start"    shift, and go to state 11
    "if start"     shift, and go to state 12
    "switch"       shift, and go to state 13
    "struct"       shift, and go to state 14

    $default  reduce using rule 1 (Program)

    block  go to state 15
    BEGIN  go to state 16


