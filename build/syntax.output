Terminals unused in grammar

   "INT"
   "CHAR"
   "VOID"
   "."
   ","
   "("
   ")"
   "["
   "]"
   "program start"
   "return"
   "vars"
   "then"
   "else"
   "elseif"
   "case"
   "default"
   "print"
   "break"
   "typedef"
   "Unknown"
   "one line comment"
   "multiline comment"


Grammar

    0 $accept: Program "EOF"

    1 Program: program_name "space" ";" block_list

    2 program_name: "any other element must be treated as a word"

    3 block_list: %empty
    4           | block_list block

    5 block: BEGIN block_list END

    6 BEGIN: "main start"
    7      | "func"
    8      | "while start"
    9      | "for start"
   10      | "if start"
   11      | "switch"
   12      | "struct"

   13 END: "main end"
   14    | "func end"
   15    | "while end"
   16    | "for end"
   17    | "if end"
   18    | "switch end"
   19    | "end struct"


